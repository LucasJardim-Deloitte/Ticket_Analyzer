# =============================================================================
# Configuração — OPCIONAL se as variáveis já estão definidas no sistema Windows.
# Copiar para .env e preencher APENAS se precisares de sobrepor as variáveis de sistema.
# O .env NUNCA vai para git.
# =============================================================================

# Proxy corporativo Anthropic Foundry (já definidos como variáveis de utilizador Windows)
# ANTHROPIC_FOUNDRY_API_KEY=cst-...
# ANTHROPIC_FOUNDRY_BASE_URL=https://cst-ai-proxy.azurewebsites.net/api/anthropic

# Modelo a usar: haiku | sonnet | opus  (default: sonnet)
# ANTHROPIC_MODEL=sonnet

# Limiar de confiança da extração (default: 0.6)
# AUDIT_CONFIDENCE_THRESHOLD=0.6
